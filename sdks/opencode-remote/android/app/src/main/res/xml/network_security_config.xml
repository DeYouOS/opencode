<?xml version="1.0" encoding="utf-8"?>
<!-- 网络安全配置：允许明文 HTTP/WS 通信（relay server 暂未启用 TLS） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
